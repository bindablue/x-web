<![endif]--><script>function firstcall(){var e=GetRequest();e.wxtoken&&(openid=e.wxtoken,console.log(openid),$("#openid").val(openid),$("#publicno").val(e.publicno)),$.ajax({type:"GET",url:webapp+"/public_key.txt",dataType:"text",success:function(e){var r=$("#pubkey").val().replace("#KEY#",e);$("#pubkey").val(r),console.log("loading key:"+r)},fail:function(e){$(".errmsg").html("公钥加载失败，请重新刷新")}})}function login(){var e=hex_md5($("#upassword1").val());e=e.toUpperCase(),console.log("md5:"+e);var r=$("#pubkey").val();console.log(r);var l=new JSEncrypt;l.setPublicKey(r);var o=l.encrypt(e);console.log("encrypted:"+o),$("#upassword").val(o),$("#upassword1").val("");var s=getFormJson("#formid");s.upassword?s.uname?(console.log(s),$(".errmsg").html("正在登录。。。"),postData(s,"/rest/user/weblogin",function(e){if("0000"!=e.CODE)$(".errmsg").html(""),$(".errmsg").html(e.MSG);else{if(""!=openid)return $(".errmsg").html("绑定成功！"),void $(".errmsg").html("");if($(".errmsg").html("登录成功！"),byApp())dismiss();else{var r=GetRequest();url=r.fromurl,url?window.location.href=decodeURIComponent(url):window.location.href="../../index.html"}}})):$(".errmsg").html("用户名不为空！"):$(".errmsg").html("密码不为空！")}function getuser(){$(".errmsg").html("正在验证用户"+$("#reguname").val()+"是否可用"),postData({uname:$.trim($("#reguname").val())},"/rest/user/exists",function(e){"0000"!=e.CODE?($(".errmsg").html(e.MSG),$("#reguname").val("")):$(".errmsg").html("")})}function regist(){if(""!=$.trim($("#reguname").val()))if(""!=$.trim($("#regupassword1").val()))if($("#regupassword1").val()==$("#regrpassword").val())if($("#regupassword1").val().length<6)$(".errmsg").html("密码必须大于6位");else if($("#reguname").val().length<6)$(".errmsg").html("用户名必须大于6位");else{var e=hex_md5($("#regupassword1").val());e=e.toUpperCase(),console.log("md5:"+e);var r=$("#pubkey").val(),l=new JSEncrypt;l.setPublicKey(r);var o=l.encrypt(e);console.log("encrypted:"+o),$("#regupassword").attr("value",o),$("#regupassword1").val("");var s=getFormJson("#regformid");$(".errmsg").html("正在注册用户，请稍等。。。"),postData(s,"/rest/user/register",function(e){"0000"!=e.CODE?$(".errmsg").html(e.MSG):(openid?($(".errmsg").html(e.MSG),this.window.opener=null,window.close()):$(".errmsg").html(e.MSG),setTimeout(function(){window.location.href="login.html"},2e3))})}else $(".errmsg").html("确认密码不一致");else $(".errmsg").html("密码不能为空");else $(".errmsg").html("用户名不能为空")}var nologin=!0,openid=""</script><script src="../../mod/encrypt/md5.js"></script><script src="../../mod/encrypt/jsencrypt.min.js"></script><script src="../../js/common.js"></script></head><body class="login-layout light-login'"><textarea id="pubkey" rows="15" style="display:none" cols="65">-----BEGIN PUBLIC KEY-----
            #KEY#
            -----END PUBLIC KEY-----</textarea><br><div class="main-container"><div class="main-content"><div class="row"><div class="col-sm-10 col-sm-offset-1"><div class="login-container"><div class="center"><h1><i class="ace-icon fa fa-leaf green"></i> <span class="red">综合</span> <span class="white" id="id-text2">管理系统</span></h1><h4 class="blue" id="id-company-text">&copy; dadadida</h4></div><div class="space-6"></div><div class="position-relative"><div id="login-box" class="login-box visible widget-box no-border"><div class="widget-body"><div class="widget-main"><h4 class="header blue lighter bigger"><i class="ace-icon fa fa-coffee green"></i> 请输入您的登录信息</h4><div class="space-6"></div><form id="formid"><fieldset><label class="block clearfix"><span class="block input-icon input-icon-right"><input type="text" class="form-control" name="uname" placeholder="用户名"> <i class="ace-icon fa fa-user"></i></span></label><label class="block clearfix"><span class="block input-icon input-icon-right"><input id="upassword1" type="password" class="form-control" placeholder="密码"> <input id="upassword" type="hidden" name="upassword" value=""> <input id="openid" type="hidden" name="openid" value=""> <input id="publicno" type="hidden" name="publicno" value=""> <i class="ace-icon fa fa-lock"></i></span></label><label class="block clearfix"><span class="label label-danger errmsg"></span></label><div class="space"></div><div class="clearfix"><label class="inline"><input type="checkbox" class="ace"> <span class="lbl">记住我</span></label><button type="button" onclick="login()" class="width-35 pull-right btn btn-sm btn-primary"><i class="ace-icon fa fa-key"></i> <span class="bigger-110">登录</span></button></div><div class="space-4"></div></fieldset></form><div class="social-or-login center hide"><span class="bigger-110">Or Login Using</span></div><div class="space-6"></div><div class="social-login center hide"><a class="btn btn-primary"><i class="ace-icon fa fa-facebook"></i> </a><a class="btn btn-info"><i class="ace-icon fa fa-twitter"></i> </a><a class="btn btn-danger"><i class="ace-icon fa fa-google-plus"></i></a></div></div><div class="toolbar clearfix"><div class="pull-right"><a href="#" data-target="#signup-box" class="user-signup-link">注册 <i class="ace-icon fa fa-arrow-right"></i></a></div></div></div></div><div id="forgot-box" class="forgot-box widget-box no-border"><div class="widget-body"><div class="widget-main"><h4 class="header red lighter bigger"><i class="ace-icon fa fa-key"></i> 获取密码</h4><div class="space-6"></div><p>请输入邮箱</p><form><fieldset><label class="block clearfix"><span class="block input-icon input-icon-right"><input type="email" class="form-control" placeholder="Email"> <i class="ace-icon fa fa-envelope"></i></span></label><label class="block clearfix"><span class="label label-danger errmsg"></span></label><div class="clearfix"><button type="button" class="width-35 pull-right btn btn-sm btn-danger"><i class="ace-icon fa fa-lightbulb-o"></i> <span class="bigger-110">发送!</span></button></div></fieldset></form></div><div class="toolbar center"><a href="#" data-target="#login-box" class="back-to-login-link">返回登录 <i class="ace-icon fa fa-arrow-right"></i></a></div></div></div><div id="signup-box" class="signup-box widget-box no-border"><div class="widget-body"><div class="widget-main"><h4 class="header green lighter bigger"><i class="ace-icon fa fa-users blue"></i> 用户注册</h4><div class="space-6"></div><p>详情</p><form id="regformid"><fieldset><label class="block clearfix"><span class="block input-icon input-icon-right"><input type="text" onblur="getuser()" name="uname" id="reguname" class="form-control" placeholder="用户名"> <i class="ace-icon fa fa-user"></i></span></label><label class="block clearfix"><span class="block input-icon input-icon-right"><input type="password" class="form-control" id="regupassword1" placeholder="密码"> <input type="hidden" name="upassword" id="regupassword" value=""> <i class="ace-icon fa fa-lock"></i></span></label><label class="block clearfix"><span class="block input-icon input-icon-right"><input type="password" class="form-control" id="regrpassword" placeholder="重复密码"> <i class="ace-icon fa fa-retweet"></i></span></label><label class="block"><input type="checkbox" class="ace"> <span class="lbl">我接受 <a href="#">用户条款</a></span></label><label class="block clearfix"><span class="label label-danger errmsg"></span></label><div class="space-24"></div><div class="clearfix"><button type="reset" class="width-30 pull-left btn btn-sm"><i class="ace-icon fa fa-refresh"></i> <span class="bigger-110">重置</span></button> <button type="button" onclick="regist()" class="width-65 pull-right btn btn-sm btn-success"><span class="bigger-110">注册</span> <i class="ace-icon fa fa-arrow-right icon-on-right"></i></button></div></fieldset></form></div><div class="toolbar center"><a href="#" data-target="#login-box" class="back-to-login-link"><i class="ace-icon fa fa-arrow-left"></i> 返回登录</a></div></div></div></div><div class="navbar-fixed-top align-right"><br>&nbsp; <a id="btn-login-dark" href="#">黑</a> &nbsp; <span class="blue">/</span> &nbsp; <a id="btn-login-blur" href="#">蓝</a> &nbsp; <span class="blue">/</span> &nbsp; <a id="btn-login-light" href="#">灰</a> &nbsp; &nbsp; &nbsp;</div></div></div></div></div></div><!--[if !IE]> --><script src="../../assets/js/jquery-2.1.4.min.js"></script><!-- <![endif]--><!--[if IE]>
