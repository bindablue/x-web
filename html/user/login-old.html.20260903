<![endif]--><script type="text/javascript">"ontouchstart"in document.documentElement&&document.write("<script src='../../assets/js/jquery.mobile.custom.min.js'><\/script>")</script><script type="text/javascript">jQuery(function(t){t(document).on("click",".toolbar a[data-target]",function(l){l.preventDefault();var a=t(this).data("target");t(".widget-box.visible").removeClass("visible"),t(a).addClass("visible")})}),jQuery(function(t){t("#btn-login-dark").on("click",function(l){t("body").attr("class","login-layout"),t("#id-text2").attr("class","white"),t("#id-company-text").attr("class","blue"),l.preventDefault()}),t("#btn-login-light").on("click",function(l){t("body").attr("class","login-layout light-login"),t("#id-text2").attr("class","grey"),t("#id-company-text").attr("class","blue"),l.preventDefault()}),t("#btn-login-blur").on("click",function(l){t("body").attr("class","login-layout blur-login"),t("#id-text2").attr("class","white"),t("#id-company-text").attr("class","light-blue"),l.preventDefault()})}),$("#btn-login-light").click(function(){})</script></body></html>
